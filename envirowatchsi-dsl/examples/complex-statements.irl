city "Ljubljana" {
    airStation "Ljubljana Bezigrad" at (14.512,46.065) {
        source "ARSO";
        status active;
        pollutant pm10 unit "ug/m3";
        pollutant pm2_5 unit "ug/m3";
        pollutant o3 unit "ug/m3";
        aqi 42 at "2026-05-21T10:00";

        list pollutants = [pm10, pm2_5, o3];

        for p in pollutants {
            threshold p warning 50 critical 100;
        }

        if pm10 > 50 {
            status test;
        } else {
            status active;
        }

        while aqi > 100 {
            threshold aqi warning 100 critical 150;
        }
    };
}
